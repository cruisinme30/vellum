{
  "$schema": "./blocks.schema.json",
  "version": 1,
  "sections": ["Basic", "Lists", "Callouts", "Layout", "Data", "Charts and plans", "Diagrams", "Media", "Interactive"],
  "nodes": [
    {
      "name": "doc",
      "doc": "The page body.",
      "impl": "tiptap",
      "content": "block+"
    },
    {
      "name": "paragraph",
      "doc": "A paragraph; its block ID is written `^blk-xxxxxxxx` after the last line.",
      "impl": "tiptap",
      "group": "block",
      "content": "inline*",
      "blockId": true,
      "markdown": "paragraph",
      "slash": [
        { "title": "Text", "description": "Plain paragraph", "keywords": ["paragraph", "p"], "section": "Basic", "icon": "notes" }
      ]
    },
    {
      "name": "heading",
      "doc": "An ATX heading, levels 1 to 6.",
      "impl": "tiptap",
      "group": "block",
      "content": "inline*",
      "defining": true,
      "blockId": true,
      "markdown": "heading",
      "attrs": { "level": { "type": "integer", "default": 1, "min": 1, "max": 6 } },
      "slash": [
        { "title": "Heading 1", "description": "Large section heading", "keywords": ["h1", "title"], "section": "Basic", "icon": "format_h1", "attrs": { "level": 1 } },
        { "title": "Heading 2", "description": "Medium section heading", "keywords": ["h2"], "section": "Basic", "icon": "format_h2", "attrs": { "level": 2 } },
        { "title": "Heading 3", "description": "Small section heading", "keywords": ["h3"], "section": "Basic", "icon": "format_h3", "attrs": { "level": 3 } }
      ]
    },
    {
      "name": "blockquote",
      "doc": "A `>` block quote.",
      "impl": "tiptap",
      "group": "block",
      "content": "block+",
      "defining": true,
      "blockId": true,
      "markdown": "blockquote",
      "slash": [
        { "title": "Quote", "description": "Quoted text", "keywords": ["blockquote", "cite"], "section": "Basic", "icon": "format_quote" }
      ]
    },
    {
      "name": "horizontalRule",
      "doc": "A `---` thematic break.",
      "impl": "tiptap",
      "group": "block",
      "atom": true,
      "markdown": "thematic_break",
      "slash": [
        { "title": "Divider", "description": "Horizontal line", "keywords": ["hr", "rule", "separator"], "section": "Basic", "icon": "horizontal_rule" }
      ]
    },
    {
      "name": "codeBlock",
      "doc": "A fenced code block; the language is the first word of the info string.",
      "impl": "custom",
      "group": "block",
      "content": "text*",
      "marks": "",
      "code": true,
      "defining": true,
      "blockId": true,
      "markdown": "fence:code",
      "attrs": { "language": { "type": "string", "default": "" } },
      "slash": [
        { "title": "Code", "description": "Code with syntax colours", "keywords": ["fence", "snippet", "pre"], "section": "Basic", "icon": "code" }
      ]
    },
    {
      "name": "mathBlock",
      "doc": "Display math between `$$` lines.",
      "impl": "custom",
      "group": "block",
      "content": "text*",
      "marks": "",
      "code": true,
      "defining": true,
      "blockId": true,
      "markdown": "math",
      "slash": [
        { "title": "Math", "description": "A TeX equation", "keywords": ["latex", "tex", "equation", "formula"], "section": "Basic", "icon": "function" }
      ]
    },
    {
      "name": "bulletList",
      "doc": "A `-` bullet list.",
      "impl": "tiptap",
      "group": "block list",
      "content": "listItem+",
      "markdown": "list:bullet",
      "slash": [
        { "title": "Bulleted list", "description": "A simple list", "keywords": ["ul", "unordered", "bullets"], "section": "Lists", "icon": "format_list_bulleted" }
      ]
    },
    {
      "name": "orderedList",
      "doc": "A numbered list.",
      "impl": "tiptap",
      "group": "block list",
      "content": "listItem+",
      "markdown": "list:ordered",
      "attrs": { "start": { "type": "integer", "default": 1, "min": 0, "max": 999999999 } },
      "slash": [
        { "title": "Numbered list", "description": "A list with numbers", "keywords": ["ol", "ordered", "numbers"], "section": "Lists", "icon": "format_list_numbered" }
      ]
    },
    {
      "name": "listItem",
      "doc": "An item of a bullet or numbered list.",
      "impl": "tiptap",
      "content": "paragraph block*",
      "defining": true,
      "markdown": "list_item"
    },
    {
      "name": "taskList",
      "doc": "A `- [ ]` task list; each task is projected into My Work.",
      "impl": "tiptap",
      "group": "block list",
      "content": "taskItem+",
      "markdown": "list:task",
      "slash": [
        { "title": "To-do list", "description": "Tasks with checkboxes", "keywords": ["todo", "task", "checkbox", "checklist"], "section": "Lists", "icon": "checklist" }
      ]
    },
    {
      "name": "taskItem",
      "doc": "One task; ticking it anywhere edits this block.",
      "impl": "tiptap",
      "content": "paragraph block*",
      "defining": true,
      "markdown": "list_item:task",
      "attrs": { "checked": { "type": "boolean", "default": false } }
    },
    {
      "name": "table",
      "doc": "A GFM table. Cells hold one paragraph, as GFM allows.",
      "impl": "custom",
      "group": "block",
      "content": "tableRow+",
      "isolating": true,
      "blockId": true,
      "markdown": "table",
      "slash": [
        { "title": "Table", "description": "Rows and columns", "keywords": ["grid", "gfm", "compare", "matrix"], "section": "Data", "icon": "table" }
      ]
    },
    {
      "name": "tableRow",
      "doc": "A table row.",
      "impl": "custom",
      "content": "(tableCell | tableHeader)*",
      "markdown": "table_row"
    },
    {
      "name": "tableHeader",
      "doc": "A header cell.",
      "impl": "custom",
      "content": "paragraph",
      "isolating": true,
      "markdown": "table_cell:header",
      "attrs": {
        "align": { "type": "enum", "values": ["none", "left", "center", "right"], "default": "none" }
      }
    },
    {
      "name": "tableCell",
      "doc": "A body cell.",
      "impl": "custom",
      "content": "paragraph",
      "isolating": true,
      "markdown": "table_cell",
      "attrs": {
        "align": { "type": "enum", "values": ["none", "left", "center", "right"], "default": "none" }
      }
    },
    {
      "name": "callout",
      "doc": "A coloured callout: `::: info`, `warn`, `good`, `crit`, `tip` or `note`.",
      "impl": "generic",
      "group": "block",
      "content": "block+",
      "defining": true,
      "blockId": true,
      "markdown": "container:callout",
      "attrs": {
        "kind": { "type": "enum", "values": ["info", "warn", "good", "crit", "tip", "note"], "default": "info" }
      },
      "slash": [
        { "title": "Info callout", "description": "Neutral information", "keywords": ["callout", "info", "aside"], "section": "Callouts", "icon": "info", "attrs": { "kind": "info" } },
        { "title": "Warning callout", "description": "Something to watch", "keywords": ["callout", "warn", "caution"], "section": "Callouts", "icon": "warning", "attrs": { "kind": "warn" } },
        { "title": "Success callout", "description": "Good news or a goal", "keywords": ["callout", "good", "success"], "section": "Callouts", "icon": "check_circle", "attrs": { "kind": "good" } },
        { "title": "Critical callout", "description": "Must not be missed", "keywords": ["callout", "crit", "danger", "error"], "section": "Callouts", "icon": "error", "attrs": { "kind": "crit" } },
        { "title": "Tip callout", "description": "A helpful hint", "keywords": ["callout", "tip", "hint"], "section": "Callouts", "icon": "lightbulb", "attrs": { "kind": "tip" } },
        { "title": "Note callout", "description": "A side note", "keywords": ["callout", "note"], "section": "Callouts", "icon": "sticky_note_2", "attrs": { "kind": "note" } }
      ]
    },
    {
      "name": "details",
      "doc": "`::: details <summary>`, collapsed by default.",
      "impl": "custom",
      "group": "block",
      "content": "block+",
      "defining": true,
      "blockId": true,
      "markdown": "container:details",
      "attrs": { "summary": { "type": "string", "default": "Details" } },
      "slash": [
        { "title": "Toggle", "description": "Collapsible section", "keywords": ["details", "collapse", "expand", "accordion"], "section": "Layout", "icon": "expand_circle_down" }
      ]
    },
    {
      "name": "columns",
      "doc": "`::: columns`, two to four columns split by `---`.",
      "impl": "generic",
      "group": "block",
      "content": "column{2,4}",
      "isolating": true,
      "blockId": true,
      "markdown": "container:columns",
      "slash": [
        { "title": "Two columns", "description": "Side-by-side content", "keywords": ["columns", "split", "layout"], "section": "Layout", "icon": "view_column_2", "template": "columns2" },
        { "title": "Three columns", "description": "Three side-by-side areas", "keywords": ["columns", "layout"], "section": "Layout", "icon": "view_week", "template": "columns3" }
      ]
    },
    {
      "name": "column",
      "doc": "One column of a `columns` container.",
      "impl": "generic",
      "content": "block+",
      "isolating": true,
      "markdown": "container_section"
    },
    {
      "name": "tabs",
      "doc": "`::: tabs`, one `##` heading per tab.",
      "impl": "custom",
      "group": "block",
      "content": "tab+",
      "isolating": true,
      "blockId": true,
      "markdown": "container:tabs",
      "slash": [
        { "title": "Tabs", "description": "Content behind tabs", "keywords": ["tabs", "tabbed"], "section": "Layout", "icon": "tab", "template": "tabs" }
      ]
    },
    {
      "name": "tab",
      "doc": "One tab; its title is the `##` heading.",
      "impl": "custom",
      "content": "block+",
      "isolating": true,
      "markdown": "container_section:tab",
      "attrs": { "title": { "type": "string", "default": "Tab" } }
    },
    {
      "name": "toc",
      "doc": "`::: toc`, built from the headings below it.",
      "impl": "custom",
      "group": "block",
      "atom": true,
      "blockId": true,
      "markdown": "container:toc",
      "slash": [
        { "title": "Table of contents", "description": "Links to the headings", "keywords": ["toc", "contents", "outline"], "section": "Layout", "icon": "toc" }
      ]
    },
    {
      "name": "stats",
      "doc": "`::: stats`, list items of value · label · delta.",
      "impl": "generic",
      "group": "block",
      "content": "bulletList",
      "blockId": true,
      "markdown": "container:stats",
      "slash": [
        { "title": "Stats", "description": "Big numbers with deltas", "keywords": ["stats", "kpi", "metrics", "numbers"], "section": "Data", "icon": "monitoring", "template": "stats" }
      ]
    },
    {
      "name": "facts",
      "doc": "`::: facts`, list items of key: value.",
      "impl": "generic",
      "group": "block",
      "content": "bulletList",
      "blockId": true,
      "markdown": "container:facts",
      "slash": [
        { "title": "Facts", "description": "Key and value pairs", "keywords": ["facts", "properties", "kv", "metadata"], "section": "Data", "icon": "fact_check", "template": "facts" }
      ]
    },
    {
      "name": "progress",
      "doc": "`::: progress`, list items of label · percent.",
      "impl": "generic",
      "group": "block",
      "content": "bulletList",
      "blockId": true,
      "markdown": "container:progress",
      "slash": [
        { "title": "Progress", "description": "Progress bars", "keywords": ["progress", "percent", "bars"], "section": "Data", "icon": "linear_scale", "template": "progress" }
      ]
    },
    {
      "name": "cards",
      "doc": "`::: cards`, list items of icon, bold title and text.",
      "impl": "generic",
      "group": "block",
      "content": "bulletList",
      "blockId": true,
      "markdown": "container:cards",
      "slash": [
        { "title": "Cards", "description": "A grid of cards", "keywords": ["cards", "grid", "features"], "section": "Layout", "icon": "grid_view", "template": "cards" }
      ]
    },
    {
      "name": "steps",
      "doc": "`::: steps`, a numbered list of steps.",
      "impl": "generic",
      "group": "block",
      "content": "orderedList",
      "blockId": true,
      "markdown": "container:steps",
      "slash": [
        { "title": "Steps", "description": "A numbered procedure", "keywords": ["steps", "procedure", "howto"], "section": "Layout", "icon": "format_list_numbered", "template": "steps" }
      ]
    },
    {
      "name": "pages",
      "doc": "`::: pages`, a card grid of linked pages; empty means the subpages.",
      "impl": "generic",
      "group": "block",
      "content": "bulletList?",
      "blockId": true,
      "markdown": "container:pages",
      "slash": [
        { "title": "Page cards", "description": "Cards for linked pages", "keywords": ["pages", "subpages", "children"], "section": "Layout", "icon": "dashboard" }
      ]
    },
    {
      "name": "linkCard",
      "doc": "`::: link <url>` with a title line; a rich link preview.",
      "impl": "custom",
      "group": "block",
      "atom": true,
      "blockId": true,
      "markdown": "container:link",
      "attrs": {
        "url": { "type": "string", "default": "" },
        "title": { "type": "string", "default": "" }
      },
      "slash": [
        { "title": "Link card", "description": "A rich link preview", "keywords": ["bookmark", "link", "url", "unfurl"], "section": "Media", "icon": "link" }
      ]
    },
    {
      "name": "embed",
      "doc": "`::: embed <url>`, shown in a sandboxed frame.",
      "impl": "custom",
      "group": "block",
      "atom": true,
      "blockId": true,
      "markdown": "container:embed",
      "attrs": { "url": { "type": "string", "default": "" } },
      "slash": [
        { "title": "Embed", "description": "Video, design or map", "keywords": ["embed", "youtube", "figma", "loom", "iframe"], "section": "Media", "icon": "smart_display" }
      ]
    },
    {
      "name": "image",
      "doc": "An image from `assets/`, written `![alt](src){width= align=}` on its own line.",
      "impl": "custom",
      "group": "block",
      "atom": true,
      "draggable": true,
      "blockId": true,
      "markdown": "image",
      "attrs": {
        "src": { "type": "string", "default": "" },
        "alt": { "type": "string", "default": "" },
        "title": { "type": "string", "default": "" },
        "width": { "type": "string", "default": "" },
        "align": { "type": "enum", "values": ["center", "left", "right"], "default": "center" }
      },
      "slash": [
        { "title": "Image", "description": "Upload or link an image", "keywords": ["image", "picture", "photo", "figure"], "section": "Media", "icon": "image" }
      ]
    },
    {
      "name": "dataFence",
      "doc": "A data fence: the body is data, drawn as a chart, plan or diagram.",
      "impl": "custom",
      "group": "block",
      "content": "text*",
      "marks": "",
      "code": true,
      "defining": true,
      "blockId": true,
      "markdown": "fence:data",
      "attrs": {
        "lang": {
          "type": "enum",
          "values": [
            "chart", "timeline", "roadmap", "risk-matrix", "board", "table", "architecture",
            "mermaid", "d2", "plantuml", "graphviz", "excalidraw", "drawio",
            "calculator", "image", "collection"
          ],
          "default": "chart"
        },
        "args": { "type": "string", "default": "" }
      },
      "slash": [
        { "title": "Chart", "description": "Bar, line, donut and more", "keywords": ["chart", "graph", "bar", "line", "pie", "donut"], "section": "Charts and plans", "icon": "bar_chart", "attrs": { "lang": "chart" }, "template": "chart" },
        { "title": "Timeline", "description": "Dated milestones", "keywords": ["timeline", "history", "dates"], "section": "Charts and plans", "icon": "timeline", "attrs": { "lang": "timeline" }, "template": "timeline" },
        { "title": "Roadmap", "description": "Bars on a calendar", "keywords": ["roadmap", "gantt", "plan"], "section": "Charts and plans", "icon": "view_timeline", "attrs": { "lang": "roadmap" }, "template": "roadmap" },
        { "title": "Risk matrix", "description": "Likelihood against impact", "keywords": ["risk", "matrix", "heatmap"], "section": "Charts and plans", "icon": "grid_on", "attrs": { "lang": "risk-matrix" }, "template": "risk" },
        { "title": "Board", "description": "A static kanban board", "keywords": ["board", "kanban", "columns"], "section": "Charts and plans", "icon": "view_kanban", "attrs": { "lang": "board" }, "template": "board" },
        { "title": "Data table", "description": "Sortable CSV with bars", "keywords": ["csv", "table", "sortable", "data"], "section": "Data", "icon": "table_view", "attrs": { "lang": "table", "args": "sortable" }, "template": "csv" },
        { "title": "Architecture", "description": "Lanes and arrows", "keywords": ["architecture", "lanes", "system"], "section": "Diagrams", "icon": "account_tree", "attrs": { "lang": "architecture" }, "template": "architecture" },
        { "title": "Mermaid diagram", "description": "Flowchart, sequence and more", "keywords": ["mermaid", "flowchart", "sequence", "diagram"], "section": "Diagrams", "icon": "schema", "attrs": { "lang": "mermaid" }, "template": "mermaid" },
        { "title": "D2 diagram", "description": "Rendered by Kroki", "keywords": ["d2", "diagram"], "section": "Diagrams", "icon": "polyline", "attrs": { "lang": "d2" } },
        { "title": "PlantUML diagram", "description": "Rendered by Kroki", "keywords": ["plantuml", "uml"], "section": "Diagrams", "icon": "polyline", "attrs": { "lang": "plantuml" } },
        { "title": "Graphviz diagram", "description": "Rendered by Kroki", "keywords": ["graphviz", "dot"], "section": "Diagrams", "icon": "polyline", "attrs": { "lang": "graphviz" } },
        { "title": "Excalidraw sketch", "description": "Rendered by Kroki", "keywords": ["excalidraw", "sketch"], "section": "Diagrams", "icon": "draw", "attrs": { "lang": "excalidraw" } },
        { "title": "draw.io diagram", "description": "Rendered by Kroki", "keywords": ["drawio", "diagrams.net"], "section": "Diagrams", "icon": "draw", "attrs": { "lang": "drawio" } },
        { "title": "Calculator", "description": "Sliders and a result", "keywords": ["calculator", "what-if", "sliders"], "section": "Interactive", "icon": "calculate", "attrs": { "lang": "calculator" }, "template": "calculator" },
        { "title": "Image gallery", "description": "Images listed in a fence", "keywords": ["gallery", "images"], "section": "Media", "icon": "photo_library", "attrs": { "lang": "image" } },
        { "title": "Collection view", "description": "Embed a live collection", "keywords": ["collection", "database", "view"], "section": "Interactive", "icon": "database", "attrs": { "lang": "collection" }, "template": "collection" }
      ]
    },
    {
      "name": "text",
      "doc": "Text.",
      "impl": "tiptap",
      "group": "inline"
    },
    {
      "name": "hardBreak",
      "doc": "A hard line break, written `\\` at the end of the line.",
      "impl": "tiptap",
      "group": "inline",
      "inline": true,
      "markdown": "hard_break"
    },
    {
      "name": "mention",
      "doc": "`@handle`, a person or group; mentioned people get an inbox item.",
      "impl": "custom",
      "group": "inline",
      "inline": true,
      "atom": true,
      "markdown": "mention",
      "attrs": { "handle": { "type": "string", "default": "" } }
    },
    {
      "name": "wikiLink",
      "doc": "`[[Title]]`, stored as `vellum://doc/<id>`.",
      "impl": "custom",
      "group": "inline",
      "inline": true,
      "atom": true,
      "markdown": "wiki_link",
      "attrs": {
        "target": { "type": "string", "default": "" },
        "label": { "type": "string", "default": "" }
      }
    },
    {
      "name": "issueKey",
      "doc": "An issue key such as `ENG-142`, shown as a live chip.",
      "impl": "custom",
      "group": "inline",
      "inline": true,
      "atom": true,
      "markdown": "issue_key",
      "attrs": { "key": { "type": "string", "default": "" } }
    },
    {
      "name": "date",
      "doc": "A calendar date (`2026-11-24`) or `@today`.",
      "impl": "custom",
      "group": "inline",
      "inline": true,
      "atom": true,
      "markdown": "date",
      "attrs": { "date": { "type": "string", "default": "today" } },
      "slash": [
        { "title": "Date", "description": "Insert today's date", "keywords": ["date", "today", "calendar"], "section": "Basic", "icon": "calendar_today" }
      ]
    },
    {
      "name": "mathInline",
      "doc": "Inline math, `$x^2$`.",
      "impl": "custom",
      "group": "inline",
      "inline": true,
      "atom": true,
      "markdown": "math_inline",
      "attrs": { "literal": { "type": "string", "default": "" } }
    }
  ],
  "marks": [
    { "name": "bold", "doc": "`**strong**`", "impl": "tiptap", "markdown": "strong" },
    { "name": "italic", "doc": "`*emphasis*`", "impl": "tiptap", "markdown": "emphasis" },
    { "name": "strike", "doc": "`~~strikethrough~~`", "impl": "tiptap", "markdown": "strikethrough" },
    { "name": "code", "doc": "`` `code` ``", "impl": "tiptap", "markdown": "code", "excludes": "_" },
    { "name": "highlight", "doc": "`==highlight==`", "impl": "tiptap", "markdown": "highlight" },
    { "name": "subscript", "doc": "`~subscript~`", "impl": "tiptap", "markdown": "subscript", "excludes": "superscript" },
    { "name": "superscript", "doc": "`^superscript^`", "impl": "tiptap", "markdown": "superscript", "excludes": "subscript" },
    {
      "name": "link",
      "doc": "`[text](url \"title\")`",
      "impl": "tiptap",
      "markdown": "link",
      "attrs": {
        "href": { "type": "string", "default": "" },
        "title": { "type": "string", "default": "" }
      }
    }
  ]
}
