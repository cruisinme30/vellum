#
# Fast formatting checks before each commit. CI runs the full set.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cargo fmt --all --check --manifest-path "${root}/Cargo.toml"
if [[ -d "${root}/web/node_modules" ]]; then
  pnpm --dir "${root}/web" exec prettier --check .
fi
