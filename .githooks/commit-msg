#
# Rejects a commit message without a Conventional Commits subject, a body
# or a DCO sign-off. Enable with: cargo xtask install-hooks
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
# shellcheck source=scripts/ci/commit-rules.sh
source "${root}/scripts/ci/commit-rules.sh"

message="$(grep -v '^#' "$1")"
subject="$(head -n1 <<<"${message}")"
[[ "${subject}" == Merge* ]] && exit 0

if ! check_subject "${subject}"; then
  echo "commit-msg: subject must be a Conventional Commit, e.g." \
    "'feat(format): parse callouts'." >&2
  exit 1
fi
if ! check_body "${message}"; then
  echo "commit-msg: add a blank line after the subject and a body saying why" \
    "(see .gitmessage)." >&2
  exit 1
fi
name="$(git config user.name)"
email="$(git config user.email)"
if ! check_signoff "${message}" "${name}" "${email}"; then
  echo "commit-msg: missing 'Signed-off-by: ${name} <${email}>'; commit with" \
      "-s." >&2
  exit 1
fi
