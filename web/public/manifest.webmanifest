{
  "id": "/",
  "name": "Vellum",
  "short_name": "Vellum",
  "description": "Docs, books, collections, issues and tasks, where every object is a Markdown file.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "theme_color": "#4F5B92",
  "background_color": "#F7F8FC",
  "categories": ["productivity", "business"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New page",
      "url": "/new?source=pwa-shortcut",
      "icons": [{ "src": "/icons/shortcut-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Search",
      "url": "/search?source=pwa-shortcut",
      "icons": [{ "src": "/icons/shortcut-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "My Work",
      "url": "/my-work?source=pwa-shortcut",
      "icons": [{ "src": "/icons/shortcut-96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ]
}
