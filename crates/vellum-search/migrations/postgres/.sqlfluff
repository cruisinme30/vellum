#
# Released migrations never change, because sqlx checks each one's
# checksum. These were written with a space before array brackets
# (`TEXT []`), so sqlfluff 4.4's LT01 reads that spacing as their style.

[sqlfluff:layout:type:start_square_bracket]
spacing_before = single
