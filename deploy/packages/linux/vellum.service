# `vellum serve` as a system service, installed by the deb and rpm
# packages. Settings go in /etc/vellum/vellum.env (see deploy/README.md for
# every variable). Enable with: sudo systemctl enable --now vellum
[Unit]
Description=Vellum workspace server
Documentation=https://cruisinme30.github.io/vellum/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=vellum
Group=vellum
EnvironmentFile=/etc/vellum/vellum.env
ExecStart=/usr/bin/vellum serve
# SIGTERM drains open requests; the server exits within 30 s (ADR 0022).
KillSignal=SIGTERM
TimeoutStopSec=35
Restart=on-failure
RestartSec=2
StateDirectory=vellum
StateDirectoryMode=0750
WorkingDirectory=/var/lib/vellum

# Hardening: the server needs its data folder and the network, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

[Install]
WantedBy=multi-user.target
