# Settings for the vellum systemd service. Every variable is listed in
# deploy/README.md. Restart after a change: sudo systemctl restart vellum
VELLUM_DATA_DIR=/var/lib/vellum
VELLUM_BIND=127.0.0.1:7700
VELLUM_PROFILE=single
# The address people use to reach the server, when it is behind a proxy:
# VELLUM_PUBLIC_URL=https://vellum.example.com
# Unlocks the key that encrypts documents at rest. Prefer a file only
# root and the vellum user can read:
# VELLUM_KEK_PASSPHRASE_FILE=/etc/vellum/kek-passphrase
