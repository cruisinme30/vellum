{
  "uid": "vellum-slo",
  "title": "Vellum: SLOs and error budgets",
  "description": "The service level objectives, their remaining error budget and burn rates.",
  "tags": [
    "vellum",
    "slo"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 9,
      "type": "stat",
      "title": "Availability: SLI over 30 days",
      "description": "Objective 99.9 %.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - (sum_over_time(vellum:slo_availability:error_ratio_1h[30d]) / count_over_time(vellum:slo_availability:error_ratio_1h[30d]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Availability: error budget left",
