              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.75, sum by (page, le) (rate({__name__=~\"vellum_client_inp(_milliseconds)?_bucket\"}[$__rate_interval])))",
          "legendFormat": "{{page}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Time to First Byte p75",
      "description": "Measured in browsers and joined to server traces. Good is under 800 ms.",
