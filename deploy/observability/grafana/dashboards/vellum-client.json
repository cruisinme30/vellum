{
  "uid": "vellum-client",
  "title": "Vellum: browser experience",
  "description": "Core Web Vitals reported by browsers, per page.",
  "tags": ["vellum", "client"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 18,
      "type": "timeseries",
      "title": "Largest Contentful Paint p75",
      "description": "Measured in browsers and joined to server traces. Good is under 2500 ms.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2500
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.75, sum by (page, le) (rate({__name__=~\"vellum_client_lcp(_milliseconds)?_bucket\"}[$__rate_interval])))",
          "legendFormat": "{{page}}"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Interaction to Next Paint p75",
      "description": "Measured in browsers and joined to server traces. Good is under 200 ms.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
