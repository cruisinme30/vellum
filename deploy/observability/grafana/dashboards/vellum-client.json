          },
          "expr": "histogram_quantile(0.75, sum by (page, le) (rate({__name__=~\"vellum_client_cls(_ratio)?_bucket\"}[$__rate_interval])))",
          "legendFormat": "{{page}}"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Browser reports per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
