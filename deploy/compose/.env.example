#
# Copy to .env next to compose.yaml and replace every "change-me".
# Generate secrets with: openssl rand -base64 32

# The external URL people open, with scheme and no trailing slash.
VELLUM_PUBLIC_URL=http://localhost:7700
VELLUM_PORT=7700
# A release image, e.g. ghcr.io/cruisinme30/vellum:1.0.0. Pin a digest in
# production.
VELLUM_IMAGE=ghcr.io/cruisinme30/vellum:latest

POSTGRES_PASSWORD=change-me
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars

# File holding the passphrase that wraps the encryption keys (Argon2id KEK).
# Losing it loses the data: back it up separately from the volumes.
VELLUM_KEK_FILE=./secrets/kek-passphrase

# File holding the base64 key that signs CSRF tokens (openssl rand -base64 32).
# Every Vellum container must read the same one.
VELLUM_CSRF_FILE=./secrets/csrf-key

VELLUM_LOG=info
# OTLP/HTTP collector, e.g. http://otel-collector:4318. Empty means no export.
OTEL_EXPORTER_OTLP_ENDPOINT=
