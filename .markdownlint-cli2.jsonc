{
  "config": {
    "default": true,
    // Lines stop at 80 characters (ADR 0074, D320). Tables, code blocks
    // and headings can't be wrapped; a line whose overflow is one long word
    // (a URL) is allowed.
    "MD013": {
      "line_length": 80,
      "tables": false,
      "code_blocks": false,
      "headings": false
    },
    "MD024": { "siblings_only": true },
    // Vellum pages carry their title in front matter and repeat it as the
    // H1 that plain mdBook shows; only a second H1 in the body is an error.
    "MD025": { "front_matter_title": "" },
    "MD033": false,
    // `::: link <url>` and `::: embed <url>` take a bare URL by design.
    "MD034": false,
    "MD041": false
  },
  "globs": ["**/*.md"],
  "ignores": ["**/node_modules/**", "target/**", "LICENSES/**",
    // Golden corpus inputs are test data, written exactly as the examples
    // in the guide; mdBook SUMMARY files use # for part titles.
    "corpus/**", "docs/*.book/SUMMARY.md"]
}
